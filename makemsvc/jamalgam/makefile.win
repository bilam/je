 ../dllsrc/jdll.o \
 ../dllsrc/jdllcomx.o


!ifdef READLINE
OBJSLN =  linenoise.o
CFLAGSLN = -DREADLINE -DUSE_LINENOISE
!endif

DEF = ../dllsrc/jdll3.def
RCS = ../makevs/jconsole/jconsole.res

!ifndef LD
LD = lld-link
!endif

!ifndef NASM
NASM = nasm
!endif

.c.o:
	$(CC) $(CFLAGS) $(CFLAGS1) /Fo$@ /c $<

.cpp.o:
	$(CC) $(CFLAGS) /Fo$@ /c $<

.asm.o:
	$(NASM) $(NASM_FLAGS) -o $@ $<

.rc.res:
	$(RC) /L 0x409 /D_USING_V110_SDK71_ -R -FO$@ $<

TARGET = jamalgam.exe

!if "1"=="$(NOSYNCHLIB)"
SYNCLIB =
!else
SYNCLIB = synchronization.lib
!endif

$(ODIR)/$(TARGET) : $(OBJS) $(OBJSLN) $(SRC_ASM) $(OBJS_ASM) $(OBJS_SIMDUTF8) $(OBJS_PTHREADS4W) $(ASM) $(PTHREADLIB) $(RCS)
	$(LD) /NOLOGO /DEF:$(DEF) $(FLAGS) /out:$@ $(OBJS) $(OBJSLN) $(SRC_ASM) $(OBJS_ASM) $(OBJS_SIMDUTF8) $(OBJS_PTHREADS4W) $(ASM) $(PTHREADLIB) $(RCS) $(MPIRLIB) ole32.lib advapi32.lib oleaut32.lib onecore.lib $(SYNCLIB) $(LOPENMP)

all: $(ODIR)/$(TARGET)

noclean:
	#

clean:
	del /f /q *.o blis\*.o openssl\sha\*.o ..\dllsrc\*.o  utf\*.o ..\pthreads4w\src\*.o ..\base64\lib\*.o ..\base64\lib\tables\*.o ..\base64\lib\arch\avx\*.o ..\base64\lib\arch\avx2\*.o ..\base64\lib\arch\avx512\*.o ..\base64\lib\arch\generic\*.o ..\base64\lib\arch\generic\32\*.o ..\base64\lib\arch\generic\64\*.o ..\base64\lib\arch\neon64\*.o ..\base64\lib\arch\ssse3\*.o ..\base64\lib\arch\sse41\*.o ..\base64\lib\arch\sse42\*.o ..\pthreads4w\src\*.o

.PHONY: all clean noclean
